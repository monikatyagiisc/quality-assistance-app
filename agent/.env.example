# Model backend: gemini | litellm | bedrock | ollama
AGENT_BACKEND=gemini
AGENT_MODEL=gemini-2.0-flash

# Gemini (when AGENT_BACKEND=gemini)
GOOGLE_API_KEY=your-gemini-api-key

# OpenAI via LiteLLM (when AGENT_BACKEND=litellm)
# AGENT_BACKEND=litellm
# AGENT_MODEL=openai/gpt-4o-mini
# OPENAI_API_KEY=your-openai-api-key

# Amazon Bedrock (when AGENT_BACKEND=bedrock)
# The 'bedrock/' prefix is added automatically if you omit it.
# AGENT_BACKEND=bedrock
# AGENT_MODEL=anthropic.claude-3-5-sonnet-20240620-v1:0
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_REGION_NAME=us-east-1
# For AWS CLI/SSO profiles, use AWS_PROFILE instead of static access keys.
# The profile must be configured for the same OS user running the agent.
# AWS_PROFILE=your-aws-profile
# Optional: only for temporary credentials (STS / assumed roles)
# AWS_SESSION_TOKEN=your-aws-session-token

# Ollama — local, free, no API key (when AGENT_BACKEND=ollama)
# The 'ollama/' prefix is added automatically if you omit it.
# AGENT_BACKEND=ollama
# AGENT_MODEL=llama3.2
# OLLAMA_API_BASE=http://localhost:11434
# Setup: https://ollama.com → install, then: ollama pull llama3.2

# Optional remote MCP integrations. Configure credentials on each MCP server,
# then provide its HTTPS endpoint and bearer token to this agent.
# Jira MCP endpoint and token
# JIRA_MCP_URL=https://your-jira-mcp-server.example.com/mcp
# JIRA_MCP_TOKEN=your-jira-mcp-bearer-token
# GitHub MCP endpoint and token
# GITHUB_MCP_URL=https://your-github-mcp-server.example.com/mcp
# GITHUB_MCP_TOKEN=your-github-mcp-bearer-token

AGENT_HOST=0.0.0.0
AGENT_PORT=8001

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
