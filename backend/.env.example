# PostgreSQL (used by backend)
DB_HOST=localhost
DB_PORT=5432
DB_USER=quality_assistance
DB_PASSWORD=your_password
DB_NAME=quality_assistance

# Optional: override the URL built from the variables above
# DATABASE_URL=postgresql+asyncpg://quality_assistance:your_password@localhost:5432/quality_assistance

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173
AGENT_SERVICE_URL=http://localhost:8001
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=10080

# Fernet key for encrypting password hashes at rest (generate a new one for production):
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-generate-with-cryptography-fernet

# Jira Cloud OAuth 2.0 (3LO) — configure an Atlassian app and callback URL first.
# JIRA_CLIENT_ID=
# JIRA_CLIENT_SECRET=
# JIRA_REDIRECT_URI=http://localhost:8000/api/settings/jira/callback
# JIRA_FRONTEND_URL=http://localhost:5173/settings

# Microsoft Entra ID (single-tenant OIDC sign-in) — see docs/ENTRA-SSO.md.
# ENTRA_TENANT_ID=<Microsoft Entra tenant GUID>
# ENTRA_CLIENT_ID=<application client ID>
# ENTRA_CLIENT_SECRET=<application client secret>
# ENTRA_REDIRECT_URI=http://localhost:8000/api/auth/entra/callback
# ENTRA_FRONTEND_URL=http://localhost:5173/login
